# Copy to /etc/cloche-server/nextcloud.env and set real values (chmod 600).
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme
# Hostname(s) you will use to reach Nextcloud (space-separated), e.g. the tailnet name.
NEXTCLOUD_TRUSTED_DOMAINS=cloche-server

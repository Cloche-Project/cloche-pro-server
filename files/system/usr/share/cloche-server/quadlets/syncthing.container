# Syncthing file synchronization. DISABLED by default: this file lives outside the Quadlet search path.
# To enable: cp to /etc/containers/systemd/, edit Volume=, then `systemctl daemon-reload && systemctl start syncthing`.
# Open the ports (web UI 8384 only if you need it beyond Tailscale):
#   firewall-cmd --permanent --add-port=22000/tcp --add-port=22000/udp --add-port=21027/udp && firewall-cmd --reload
[Unit]
Description=Syncthing
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=syncthing
Image=docker.io/syncthing/syncthing:latest
Environment=PUID=1000
Environment=PGID=1000
PublishPort=8384:8384
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
PublishPort=21027:21027/udp
# :Z relabels for SELinux; without it the container gets "Permission denied".
Volume=/var/srv/syncthing:/var/syncthing:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
